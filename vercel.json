{
  "buildCommand": "node build.js",
  "outputDirectory": "dist",
  "cleanUrls": false,
  "redirects": [{ "source": "/", "destination": "/ar/", "permanent": false }],
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }]
    }
  ]
}
